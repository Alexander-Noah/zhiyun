<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- 后端日志输出目录；默认写入 Backend/logs。 -->
    <property name="LOG_PATH" value="logs"/>
    <!-- 统一日志格式：时间、级别、线程、请求ID、日志类名、日志内容。 -->
    <property name="LOG_PATTERN" value="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] [%X{requestId}] %logger{36} - %msg%n"/>

    <!-- 控制台输出：开发调试时在终端查看。 -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- 文件输出：写入 backend.log，并按日期和大小滚动归档。 -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <!-- 当前正在写入的主日志文件。 -->
        <file>${LOG_PATH}/backend.log</file>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <!-- 历史日志命名规则；按日期和序号压缩为 gz 文件。 -->
            <fileNamePattern>${LOG_PATH}/backend.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <!-- 单个日志文件最大大小。 -->
            <maxFileSize>20MB</maxFileSize>
            <!-- 历史日志最多保留 14 天。 -->
            <maxHistory>14</maxHistory>
            <!-- 全部历史日志最大占用空间。 -->
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <!-- 项目业务代码日志级别。 -->
    <logger name="org.example.backend" level="INFO"/>
    <!-- MyBatis 框架日志级别；WARN 可减少 SQL 框架噪音。 -->
    <logger name="org.mybatis" level="WARN"/>
    <!-- Spring 框架日志级别。 -->
    <logger name="org.springframework" level="INFO"/>

    <!-- 全局默认日志级别，同时输出到控制台和文件。 -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>
</configuration>
